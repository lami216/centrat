{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Centrat",
  "version": "1.1.0",
  "identifier": "mr.centrat.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Centrat",
        "width": 1440,
        "height": 900,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
